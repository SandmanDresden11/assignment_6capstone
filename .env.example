# Supabase (the two Supabase keys referenced in Assignment 5B: project URL + service role key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (get this from platform.claude.com, NOT your Claude Pro login -- see Reading 3)
ANTHROPIC_API_KEY=

# Optional: protects the cron endpoint. If set, Vercel Cron sends it automatically
# as "Authorization: Bearer <value>". You can also test manually by visiting
# /api/cron/overdue-check?secret=<value> in your browser.
CRON_SECRET=
